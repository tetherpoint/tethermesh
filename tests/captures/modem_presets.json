{
  "corpus": "modem_presets",
  "boundary": "the node's own boot report, after writing LoRaConfig.modem_preset over the serial admin API",
  "provenance": {
    "captured": "2026-08-16",
    "node": "Heltec V3, stock Meshtastic 2.7.26.54e0d8d, region US",
    "oracle_version": "2.7.26.54e0d8d - same build as the pinned container in DEPS.md",
    "method": "For each preset 0..16: write the WHOLE LoRaConfig section with use_preset=true and that modem_preset, reboot, and read the values the node reports at boot.",
    "note": "Our own board, our own configuration. No third-party traffic, nothing identifiable. Publishable under TESTING.md.",
    "clean_room_note": "Values are read from the node's own log output - black-box observation. No reference source was read."
  },
  "derivation": {
    "preamble_symbols": 16,
    "spreading_factor": "SF = log2((preamble_ms/1000/16) * bandwidth_hz). Bandwidth is reported outright; SF is not, and falls out of the preamble time.",
    "validated_against": "LongFast, whose SF11/BW250/CR4-5 was independently established by on-air capture. One preset with two independent derivations is what licenses the derivation for the rest.",
    "coding_rate": "NOT REPORTED by the node and deliberately left null. The reported bitrate cannot invert to a coding rate: the ratio of reported bitrate to SF*BW/2^SF varies with SF (0.697 at SF11, 0.725 at SF7), so that figure carries packet overhead of an unknown shape. Inferring CR from it would mean assuming a formula in order to derive a fact."
  },
  "findings": {
    "valid_presets": 9,
    "invalid_presets": [
      2,
      10,
      11,
      12,
      13,
      14,
      15,
      16
    ],
    "invalid_behaviour": "Reported as name=Invalid and silently served LongFast parameters. Preset 2 is the deprecated VERY_LONG_SLOW; 10-16 are beyond the enum.",
    "correction": "PLAN.md previously recorded 'sixteen presets remain'. There are eight further VALID presets beyond LongFast, not sixteen."
  },
